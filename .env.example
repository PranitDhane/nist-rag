# Optional overrides; defaults are relative to the project root.
# DATA_DIR=data
# RAW_DIR=data/raw
# PROCESSED_DIR=data/processed
# STAGES_DIR=data/processed/stages
# OCR_CONFIDENCE_THRESHOLD=60   # figure OCR below this confidence is dropped; 'none' keeps everything

# Embedding & indexing overrides
# INDEX_CHROMA_DIR=data/chroma
# INDEX_DIR=data/index
# INDEX_COLLECTION=nist_ai_rmf
# INDEX_BATCH_SIZE=32
# INDEX_DEVICE=auto   # auto | cpu | mps | cuda
# CHUNKS_PATH=data/processed/chunks.jsonl
