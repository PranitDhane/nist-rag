# Optional overrides; defaults are relative to the project root.
# DATA_DIR=data
# RAW_DIR=data/raw
# PROCESSED_DIR=data/processed
# STAGES_DIR=data/processed/stages
# OCR_CONFIDENCE_THRESHOLD=60   # figure OCR below this confidence is dropped; 'none' keeps everything

# Embedding & indexing overrides
# INDEX_CHROMA_DIR=data/chroma
# INDEX_DIR=data/index
# INDEX_COLLECTION=nist_ai_rmf
# INDEX_BATCH_SIZE=32
# INDEX_DEVICE=auto   # auto | cpu | mps | cuda
# CHUNKS_PATH=data/processed/chunks.jsonl

# API & routing (GROQ_API_KEY is required; never commit the real value)
GROQ_API_KEY=
# ROUTER_MODEL=openai/gpt-oss-120b
# APP_HOST=127.0.0.1
# APP_PORT=8000
# MAX_MESSAGE_CHARS=2000
# LLM_MAX_ATTEMPTS=4

# Optional LangSmith tracing: OFF unless LANGSMITH_TRACING=true. WHEN ON, every prompt, every retrieved NIST passage and
# every answer is SENT TO LANGSMITH'S SERVERS (api.smith.langchain.com unless LANGSMITH_ENDPOINT says otherwise).
LANGSMITH_TRACING=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
