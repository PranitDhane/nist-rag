          "score": 0.0035
        },
        {
          "chunk_id": "ai_rmf_1_0:prose:0006:1",
          "score": 0.0063
        }
      ]
    },
    {
      "turn": "S6",
      "sentence": "Protocols are put in place to ensure GAI systems are able to be deactivated when necessary.",
      "keys": [
