    {
      "turn": "S1",
      "chunk_id": "ai_rmf_1_0:prose:0020:1",
      "sentence": "The AI RMF Core provides outcomes and actions that enable dialogue, understanding, and activities to manage AI risks and responsibly develop trustworthy AI systems.",
